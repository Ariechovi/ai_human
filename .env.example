APP_ENV=dev

# 数据库：通过 SSH 隧道访问服务器上的 PostgreSQL
# 本地端口、密码请按实际隧道填写；密码不要提交到 Git
DATABASE_URL=postgresql+asyncpg://ariechovi:CHANGE_ME@127.0.0.1:5433/ai_human
REDIS_URL=redis://127.0.0.1:6379/0

# 对话模型：OpenAI 兼容接口
MODEL_NAME=gpt-4o-mini
MODEL_BASE_URL=
MODEL_API_KEY=CHANGE_ME

# Embedding 模型
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=CHANGE_ME

# pgvector 维度，需与 Embedding 模型输出一致
VECTOR_DIM=1536

# 上下文策略
SHORT_TERM_WINDOW=10
SUMMARY_TOKEN_CUTOFF=3000
RAG_TOP_K=4


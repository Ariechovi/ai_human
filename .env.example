APP_ENV=dev

# 数据库：通过 SSH 隧道访问服务器上的 PostgreSQL，本地端口 15432
DATABASE_URL=postgresql+asyncpg://ariechovi:CHANGE_ME@127.0.0.1:15432/ai_human
REDIS_URL=redis://127.0.0.1:16379/0

# 对话模型：DeepSeek，OpenAI 兼容接口
MODEL_NAME=deepseek-chat
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=CHANGE_ME

# Embedding 模型：阿里云 DashScope，OpenAI 兼容接口
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=CHANGE_ME

# pgvector 维度：待核验 qwen3.7-text-embedding 的实际输出维度
VECTOR_DIM=1536

# 上下文策略
SHORT_TERM_WINDOW=10
SUMMARY_TOKEN_CUTOFF=3000
RAG_TOP_K=4

